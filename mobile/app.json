{
  "expo": {
    "name": "PlantCare AI",
    "slug": "plantcare-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "plantcareai",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E5A3F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plantcareai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PlantCare AI usa la cámara para identificar plantas.",
        "NSPhotoLibraryUsageDescription": "PlantCare AI accede a tu galería para analizar fotos de plantas."
      }
    },
    "android": {
      "package": "com.plantcareai.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"],
      "adaptiveIcon": { "backgroundColor": "#0E5A3F" }
    },
    "plugins": [
      "expo-image-picker",
      "expo-notifications"
    ],
    "extra": {
      "eas": { "projectId": "" }
    }
  }
}
