PORT=4000

# ===== Proveedor de IA =====
# Dejá vacío para auto-detectar (Gemini si hay GEMINI_API_KEY,
# luego Anthropic, sino mock). O forzá: gemini | anthropic | mock
AI_PROVIDER=

# Google Gemini
GEMINI_API_KEY=
# Modelo opcional (default: gemini-2.0-flash). También podés probar:
# gemini-1.5-pro / gemini-2.5-pro
GEMINI_MODEL=

# Anthropic Claude (alternativa)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Forzar respuestas simuladas (útil sin API keys)
USE_MOCK_AI=false
